xfund_es_sample/

# Imágenes de prueba con datos personales reales
imagenes_crudas/

# Resultados de ejecución (JSON de salida de OCR, regenerables)
resultados/
resultados_*/

# Carpeta de salida de herramientas de etiquetado
etiquetado_salida/

# Configuración local del asistente / sesión
.claude/

# Sistema operativo / editor
